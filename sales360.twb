      <aliases enabled='yes' />
      <column caption='Won Revenue' datatype='real' name='[Calculation_466404082457849857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stage] = &quot;Closed Won&quot; THEN [deal_value] END' />
      </column>
      <column caption='Oppurtunity Count' datatype='integer' name='[Calculation_466404082459230210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Win Rate' datatype='real' name='[Calculation_651896091745439744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([stage] = &apos;Closed Won&apos;, 1, 0)) * 1.0&#13;&#10;   / SUM(IIF([stage] IN (&apos;Closed Won&apos;,&apos;Closed Lost&apos;), 1, 0))' />
      </column>
